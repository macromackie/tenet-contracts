// Extend only where a separate test runner supplies both its test and assertion functions.
{
  "overrides": [
    {
      "files": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/test/**",
        "**/tests/**",
        "**/__tests__/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "message": "Import `expect` and the other assertion functions by name from the test runner's module, such as `import { expect, test } from 'vitest'`.",
                "name": "node:assert"
              },
              {
                "message": "Import `expect` and the other assertion functions by name from the test runner's module, such as `import { expect, test } from 'vitest'`.",
                "name": "node:assert/strict"
              },
              {
                "message": "Import `expect` and the other assertion functions by name from the test runner's module, such as `import { expect, test } from 'vitest'`.",
                "name": "assert"
              },
              {
                "message": "Import `expect` and the other assertion functions by name from the test runner's module, such as `import { expect, test } from 'vitest'`.",
                "name": "assert/strict"
              },
              {
                "message": "Import `test` and the other test runner functions by name from the test runner's module, such as `import { expect, test } from 'vitest'`, never from the runtime's test module.",
                "name": "node:test"
              }
            ],
            "patterns": [
              {
                "importNames": [
                  "default"
                ],
                "message": "Import a runtime built-in module's names by name, such as `import { readFile } from 'node:fs/promises'`; its default export is the whole module.",
                "regex": "^node:"
              }
            ]
          }
        ]
      }
    }
  ]
}
