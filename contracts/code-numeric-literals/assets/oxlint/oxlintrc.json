{
  "overrides": [
    {
      "files": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/test/**",
        "**/tests/**",
        "**/testing/**",
        "**/__tests__/**"
      ],
      "rules": {
        // C: code-numeric-literals lets a test file write numbers bare.
        "no-magic-numbers": "off"
      }
    }
  ],
  "rules": {
    "no-magic-numbers": [
      "error",
      {
        "detectObjects": false,
        "enforceConst": true,
        "ignore": [-1, 0, 1],
        "ignoreArrayIndexes": true,
        "ignoreClassFieldInitialValues": false,
        "ignoreDefaultValues": false,
        "ignoreEnums": true,
        "ignoreNumericLiteralTypes": true,
        "ignoreReadonlyClassProperties": true,
        "ignoreTypeIndexes": true
      }
    ]
  }
}
