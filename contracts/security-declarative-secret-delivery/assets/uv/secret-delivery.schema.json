{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowedUnusedManifestSecrets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["name", "reason"],
        "type": "object"
      },
      "type": "array"
    },
    "bannedScriptPatterns": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "builtinWorkflowSecrets": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "manifestPath": {
      "minLength": 1,
      "type": "string"
    },
    "runtimeBindingPatterns": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "workflowPatterns": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "allowedUnusedManifestSecrets",
    "bannedScriptPatterns",
    "builtinWorkflowSecrets",
    "manifestPath",
    "runtimeBindingPatterns",
    "workflowPatterns"
  ],
  "title": "Secret delivery manifest policy",
  "type": "object"
}
