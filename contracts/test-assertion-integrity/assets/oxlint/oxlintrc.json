// Extend this file only where vitest runs the repository's tests, after code-lint-strictness's `vitest.json`.
{
  "overrides": [
    {
      "files": ["**/*.test.*", "**/*.spec.*"],
      "plugins": ["vitest"],
      "rules": {
        "vitest/no-conditional-in-test": "error",
        "vitest/prefer-expect-assertions": "error"
      }
    }
  ]
}
