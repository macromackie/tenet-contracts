{
  "overrides": [
    {
      "files": ["**/*.test.*", "**/*.spec.*", "**/test/**", "**/tests/**", "**/__tests__/**"],
      "plugins": ["vitest"],
      "rules": {
        "vitest/require-top-level-describe": [
          "error",
          {
            "maxNumberOfTopLevelDescribes": 1
          }
        ]
      }
    }
  ]
}
