{
  "jsPlugins": ["eslint-plugin-sonarjs"],
  "overrides": [
    {
      "files": ["**/*.tsx", "**/*.jsx"],
      "rules": {
        "max-lines-per-function": [
          "error",
          { "IIFEs": true, "max": 60, "skipBlankLines": true, "skipComments": true }
        ]
      }
    }
  ],
  "rules": {
    "complexity": ["error", { "max": 10, "variant": "classic" }],
    "max-depth": ["error", { "max": 3 }],
    "max-lines-per-function": [
      "error",
      { "IIFEs": true, "max": 50, "skipBlankLines": true, "skipComments": true }
    ],
    "max-nested-callbacks": ["error", { "max": 3 }],
    "max-statements": ["error", { "ignoreTopLevelFunctions": false, "max": 10 }],
    "react/jsx-max-depth": ["error", { "max": 6 }],
    "sonarjs/cognitive-complexity": ["error", 15]
  }
}
