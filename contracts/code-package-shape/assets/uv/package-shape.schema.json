{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "deployEntries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "package": {
            "minLength": 1,
            "type": "string"
          },
          "reason": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": ["name", "package", "reason"],
        "type": "object"
      },
      "type": "array"
    },
    "entryFiles": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "generatedEntries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "reason": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": ["name", "reason"],
        "type": "object"
      },
      "type": "array"
    },
    "manifest": {
      "minLength": 1,
      "type": "string"
    },
    "maximumFlatModules": {
      "minimum": 1,
      "type": "integer"
    },
    "packagePatterns": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "minItems": 1
    },
    "roleFiles": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "sourceFolder": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "deployEntries",
    "entryFiles",
    "generatedEntries",
    "manifest",
    "maximumFlatModules",
    "packagePatterns",
    "roleFiles",
    "sourceFolder"
  ],
  "type": "object"
}
