{
  "overrides": [
    {
      "files": ["**/logger/log.ts", "**/logger/log.mts"],
      "rules": {
        // C: telemetry-application-tracing allows console calls and stream handles only in the logger module.
        "no-console": "off",
        // C: same as `no-console`.
        "no-restricted-properties": "off"
      }
    }
  ],
  "rules": {
    "no-console": "error",
    "no-restricted-properties": [
      "error",
      { "object": "process", "property": "stdout" },
      { "object": "process", "property": "stderr" },
      { "object": "globalThis", "property": "console" },
      // Effect's console service and the Effect functions that write a log line.
      { "object": "Console" },
      { "object": "Effect", "property": "log" },
      { "object": "Effect", "property": "logDebug" },
      { "object": "Effect", "property": "logError" },
      { "object": "Effect", "property": "logFatal" },
      { "object": "Effect", "property": "logInfo" },
      { "object": "Effect", "property": "logTrace" },
      { "object": "Effect", "property": "logWarning" },
      { "object": "Effect", "property": "logWithLevel" }
    ]
  }
}
