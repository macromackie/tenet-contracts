{
  "overrides": [
    {
      "files": ["**/logger/log.ts"],
      "rules": {
        // C: telemetry-application-tracing allows console calls and stream handles only in the logger module.
        "no-console": "off",
        // C: same as `no-console`.
        "no-restricted-properties": "off"
      }
    }
  ],
  "rules": {
    "no-console": "error",
    "no-restricted-properties": [
      "error",
      { "object": "process", "property": "stdout" },
      { "object": "process", "property": "stderr" },
      { "object": "globalThis", "property": "console" }
    ]
  }
}
